# Airtable Configuration for Registration Form
# Get your API key from: https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxx

# Get Base ID from your Airtable base URL: https://airtable.com/[BASE_ID]/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table name (default: Registrations)
AIRTABLE_TABLE_NAME=Registrations
